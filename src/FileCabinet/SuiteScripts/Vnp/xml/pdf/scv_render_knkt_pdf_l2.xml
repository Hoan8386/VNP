<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="Times" type="font" subtype="opentype"
              src="${libPdf.font.times?html}"
              src-bold="${libPdf.font.times_bold?html}"
              src-italic="${libPdf.font.times_italic?html}"
              src-bolditalic="${libPdf.font.times_bolditalic?html}"
              bytes="2"/>
        <style type="text/css">
            * {
            font-family: Times;
            font-size: 10pt;
            }
            table {
            font-family: Times;
            font-size: 10pt;
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            }
            td {
            font-family: Times;
            font-size: 10pt;
            text-align: center;
            }
            .h1 {
            font-size: 18pt;
            }
            .table-cus {
            width: 100%;
            border-spacing: 0;
            }
            .cell {
            border-left: 0.5pt solid black;
            border-bottom: 0.5pt solid black;
            padding: 4pt;
            text-align: center;
            }
            .cell-last {
            border-left: 0.5pt solid black;
            border-right: 0.5pt solid black;
            border-bottom: 0.5pt solid black;
            padding: 4pt;
            text-align: center;
            }
            .cell-top {
            border-top: 0.5pt solid black;
            }
            .cell-left {
            text-align: left;
            }
            .bold {
            font-weight: bold;
            }
            .m-0{
            margin: 0;
            padding: 0;
            }
        </style>
    </head>
    <!-- // TODO(BA-Q3): Confirm that this report should remain A4 portrait. -->
    <body size="A4" orientation="portrait" padding="30px">
        <table width="100%">
            <tr>
                <td align="center">
                    <p class="bold" margin="0" padding="0">BÁO CÁO KẾT QUẢ THỰC HIỆN CÁC KHUYẾN NGHỊ</p>
                    <p class="bold" margin="0" padding="0">TẠI BÁO CÁO KIỂM TOÁN NỘI BỘ SỐ ${dataJson.soBaoCao?html} BAN HÀNH NGÀY ${dataJson.ngayPhatHanh?html}</p>
                    <p class="bold" margin="0" padding="0">CÔNG TY ${dataJson.congTy?html} – ${dataJson.donVi?html}</p>
                    <p align="center" margin="0" padding="0"><i>Cập nhật đến <#if dataJson.ngayCapNhat?has_content>${dataJson.ngayCapNhat?html}<#else>…</#if></i></p>
                </td>
            </tr>
        </table>

        <#list dataJson.phatHienList as ph>
            <p class="bold" style="text-align: left;" margin-top="12px" margin-bottom="0">Phát hiện ${ph.stt?html}. ${ph.chiTietPhatHien?html}</p>
            <p style="text-align: left;" margin="0">Tổng Giám đốc, Giám đốc Chi nhánh chỉ đạo các phòng, bộ phận có liên quan thực hiện các nội dung sau:</p>
            <table width="100%" class="table-cus" margin-bottom="12px">
                <!-- TODO(BA-Q18): Mockup FDD gạch chân nhãn header, mẫu lần 1 không gạch — chọn cái nào? -->
                <thead>
                    <tr>
                        <td class="cell cell-top bold" width="6%" align="center">TT</td>
                        <td class="cell cell-top bold" width="22%" align="center">Khuyến nghị</td>
                        <td class="cell cell-top bold" width="14%" align="center">Thời hạn<br/>phản hồi</td>
                        <td class="cell cell-top bold" width="29%" align="center">Tình hình và kết quả thực hiện<br/>đến ngày <#if ph.ngayThucHienTruoc?has_content>${ph.ngayThucHienTruoc?html}<#else>…</#if></td>
                        <td class="cell-last cell-top bold" width="29%" align="center">Tình hình và kết quả thực hiện<br/>đến ngày <#if ph.ngayThucHien?has_content>${ph.ngayThucHien?html}<#else>…</#if></td>
                    </tr>
                </thead>
                <tbody>
                    <#list ph.khuyenNghiList as kn>
                        <tr>
                            <td class="cell" align="center">${kn.stt?html}</td>
                            <td class="cell cell-left">${kn.khuyenNghi?html}</td>
                            <td class="cell" align="center">${kn.thoiHanPhanHoi?html}</td>
                            <td class="cell cell-left">${kn.tinhHinhThucHienTruoc?html?replace("\r\n", "<br/>")?replace("\n", "<br/>")}</td>
                            <td class="cell-last cell-left">${kn.tinhHinhThucHien?html?replace("\r\n", "<br/>")?replace("\n", "<br/>")}</td>
                        </tr>
                    </#list>
                </tbody>
            </table>
        </#list>

        <table width="100%" margin-top="20px">
            <tr>
                <td width="40%"></td>
                <td width="60%" align="center">
                    <p class="bold" align="center" margin="0" padding="0">Ngày ${dataJson.ngayKy?html} tháng ${dataJson.thangKy?html} năm ${dataJson.namKy?html}</p>
                    <p class="bold" align="center" margin="0" padding="0">CÔNG TY ${dataJson.congTy?html} - ${dataJson.donVi?html}</p>
                </td>
            </tr>
        </table>
    </body>
</pdf>
