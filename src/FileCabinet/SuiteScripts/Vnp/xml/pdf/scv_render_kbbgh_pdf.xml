<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="Times" type="font" subtype="opentype"
              src="${libPdf.font.times?html}"
              src-bold="${libPdf.font.times_bold?html}"
              src-italic="${libPdf.font.times_italic?html}"
              src-bolditalic="${libPdf.font.times_bolditalic?html}"
              bytes="2"/>
        <style type="text/css">
            * {
            font-family: Times;
            font-size: 10pt;
            }
            table {
            font-family: Times;
            font-size: 10pt;
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            }
            td {
            font-family: Times;
            font-size: 10pt;
            text-align: center;
<!--            vertical-align: middle;-->
            }
            .h1 {
            font-size: 18pt;
            }
            .table-cus {
            width: 100%;
            border-spacing: 0;
            }
            .cell {
            border-left: 0.5pt solid black;
            border-bottom: 0.5pt solid black;
            padding: 6pt 4pt;
            text-align: center;
            }
            .cell-last {
            border-left: 0.5pt solid black;
            border-right: 0.5pt solid black;
            border-bottom: 0.5pt solid black;
            padding: 6pt 4pt;
            text-align: center;
            }
            .cell-top {
            border-top: 0.5pt solid black;
            }
            .bold {
            font-weight: bold;
            }
            .m-0{
            margin: 0;
            padding: 0;
            }
        </style>
    </head>
    <body size="A4" orientation="portrait" padding="30px">
        <!-- Subsidiary information -->
        <table width="100%" style="margin-top: 0;">
            <tr margin-bottom="20px">
                <td style="text-align: left;" width="100%">
                    <p class="bold" margin="0" padding="0">${dataJson.legalname}</p>
                    <p margin="0" padding="0">${dataJson.mainaddress_text}</p>
                </td>
            </tr>
        </table>

        <!-- Title and date -->
        <table width="100%" style="margin-top: 30px;">
            <tr>
                <td align="center">
                    <b class="h1">PHIẾU XUẤT KHO KIÊM BIÊN BẢN GIAO HÀNG</b>
                </td>
            </tr>
            <tr style="margin-top: 8px;">
                <td align="center">
                    Ngày ${dataJson.tranday} tháng ${dataJson.tranmonth} năm ${dataJson.tranyear}
                </td>
            </tr>
        </table>

        <!-- Receiver, entity, and delivery address -->
        <table width="100%" style="margin-top: 24px;">
            <tr>
                <td style="text-align: left; padding: 3pt 0;" width="18%">Người nhận hàng:</td>
                <td style="text-align: left; padding: 3pt 0;" width="82%">${dataJson.receiver}</td>
            </tr>
            <tr>
                <td style="text-align: left; padding: 3pt 0;" width="18%">Đơn vị:</td>
                <td style="text-align: left; padding: 3pt 0;" width="82%">${dataJson.entityName}</td>
            </tr>
            <tr>
                <td style="text-align: left; padding: 3pt 0;" width="18%">Địa chỉ:</td>
                <td style="text-align: left; padding: 3pt 0;" width="82%">${dataJson.shipaddress}</td>
            </tr>
        </table>

        <!-- Item lines -->
        <table width="100%" class="table-cus" align="center" style="margin-top: 18px;">
            <thead>
                <tr height="30px">
                    <td class="cell cell-top bold" width="70%" align="center">Tên hàng hóa</td>
                    <td class="cell cell-top bold" width="12%" align="center">Đvt</td>
                    <td class="cell-last cell-top bold" width="18%" align="center">Số lượng</td>
                </tr>
            </thead>
            <tbody>
                <#list dataJson.lines as line>
                <#if line_has_next>
                    <#assign lineBorder = "0.5pt dotted black">
                <#else>
                    <#assign lineBorder = "0.5pt solid black">
                </#if>
                <tr height="30px">
                    <td class="cell" style="border-bottom: ${lineBorder}; text-align: left;" align="left">${line.tenHang}</td>
                    <td class="cell" style="border-bottom: ${lineBorder};" align="center">${line.dvt}</td>
                    <td class="cell-last" style="border-bottom: ${lineBorder}; text-align: right;" align="right">${line.soLuong}</td>
                </tr>
                </#list>
                <#if dataJson.lines?size == 0>
                <tr height="30px">
                    <td class="cell" style="border-bottom: 0.5pt solid black; text-align: left;" align="left">&#160;</td>
                    <td class="cell" style="border-bottom: 0.5pt solid black;" align="center">&#160;</td>
                    <td class="cell-last" style="border-bottom: 0.5pt solid black; text-align: right;" align="right">&#160;</td>
                </tr>
                </#if>
            </tbody>
        </table>

        <!-- Signatures -->
        <table width="100%" style="margin-top: 60px;">
            <tr>
                <td style="text-align: left; padding-bottom: 70px;" align="left" width="50%">
                    <table width="70%" style="width: 70%;" align="left">
                        <tr>
                            <td style="text-align: center;" align="center">
                                <p align="center" class="bold" margin="0" padding="0">NGƯỜI GIAO HÀNG</p>
                                <p align="center" margin="0" padding="0"><i>(Ký, họ tên)</i></p>
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="text-align: right; padding-bottom: 70px;" align="right" width="50%">
                    <table width="70%" style="width: 70%;" align="right">
                        <tr>
                            <td style="text-align: center;" align="center">
                                <p align="center" class="bold" margin="0" padding="0">NGƯỜI NHẬN HÀNG</p>
                                <p align="center" margin="0" padding="0"><i>(Ký, họ tên)</i></p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</pdf>
