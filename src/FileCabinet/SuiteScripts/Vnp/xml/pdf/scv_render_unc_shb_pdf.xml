<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <link name="Times" type="font" subtype="opentype"
        src="${libPdf.font.times?html}"
        src-bold="${libPdf.font.times_bold?html}"
        src-italic="${libPdf.font.times_italic?html}"
        src-bolditalic="${libPdf.font.times_bolditalic?html}"
        bytes="2"/>
    <style type="text/css">
        * { font-family: Times; font-size: 8pt; }
        p { line-height: 9pt; margin: 0 0 1px 0; }
        table { border-collapse: collapse; table-layout: fixed; width: 100%; }
        td { vertical-align: top; }
        .no-border, .no-border td { border: none; }
        .copy { margin-bottom: 5px; page-break-inside: avoid; }
        .copy-header { margin-bottom: 1px; }
        .logo-space { height: 18px; width: 85px; }
        .model-code { font-size: 7.5pt; font-weight: bold; text-align: right; }
        .title {
            color: #d76721; font-size: 11pt; font-weight: bold;
            text-align: center;
        }
        .grid { border: 0.7pt solid #d76721; }
        .grid td { border: 0.45pt solid #d76721; padding: 2px; }
        .grid .no-border td { border: none; padding: 1px; }
        .details td { border: none; padding: 1px 2px; }
        .section { color: #d76721; font-weight: bold; }
        .bold { font-weight: bold; }
        .tick {
            border: 0.6pt solid #000000; height: 10px; text-align: center;
            width: 10px;
        }
        .signature { border: 0.7pt solid #d76721; margin-top: 2px; }
        .signature td {
            border: 0.45pt solid #d76721; height: 42px; padding: 2px;
            text-align: center;
        }
        .signature-note { font-size: 7pt; line-height: 8pt; }
        .memo { min-height: 18px; }
    </style>
</head>
<body size="A4" width="297mm" height="210mm" orientation="landscape" padding="30px">
    <#assign lienList = ["01", "02"]>
    <#list lienList as lien>
    <div class="copy">
        <table class="no-border copy-header">
            <tr>
                <td width="25%" class="logo-space" rowspan="2">
                    <!-- TODO: logo ngân hàng, chưa có file trong File Cabinet -->
                </td>
                <td width="50%">&#160;</td>
                <td width="25%" class="model-code">Mẫu số 01/TTKDTM-SHB</td>
            </tr>
            <tr>
                <td><p class="title">UỶ NHIỆM CHI/PAYMENT ORDER</p></td>
                <td style="text-align:right;">Liên: ${lien?html}</td>
            </tr>
        </table>
        <table class="no-border">
            <tr>
                <td width="50%">Ngày (Date): ${(dataJson.ngayCT!'')?html}</td>
                <td width="50%">Số (Ref No):........................</td>
            </tr>
        </table>
        <table class="grid">
            <tr>
                <td width="55%">
                    <p class="section">ĐƠN VỊ CHUYỂN TIỀN(Applicant):</p>
                    <table class="details">
                        <tr>
                            <td width="34%"><b>Tên đơn vị trả tiền:<br/>Account Name</b></td>
                            <td>${(dataJson.tenNguoiTra!'')?html}</td>
                        </tr>
                        <tr>
                            <td><b>Số tài khoản:<br/>Account No.</b></td>
                            <td>${(dataJson.stkNguoiTra!'')?html}</td>
                        </tr>
                        <tr>
                            <td><b>Địa chỉ:<br/>Address</b></td>
                            <td>
                                <#-- TODO(BA-Q5): Địa chỉ người trả tiền, giữ trống. -->
                                &#160;
                            </td>
                        </tr>
                        <tr>
                            <td><b>Tại ngân hàng:With bank</b></td>
                            <td>${(dataJson.nhNguoiTra!'')?html}</td>
                        </tr>
                    </table>
                </td>
                <td width="45%" rowspan="2">
                    <p class="section">SỐ TIỀN(Amount)</p>
                    <p><b>Bằng số(In figures):</b> ${(dataJson.soTien!'')?html}
                        ${(dataJson.maTienTe!'')?html}</p>
                    <p><b>Bằng chữ (In words):</b>
                        ${(dataJson.soTienBangChu!'')?html}</p>
                    <p><b>Phí NH:Bank charges</b></p>
                    <table class="no-border">
                        <tr>
                            <td class="tick">${(dataJson.tickPhiTrong!'')?html}</td>
                            <td>Phí trongIncluding</td>
                            <td class="tick">${(dataJson.tickPhiNgoai!'')?html}</td>
                            <td>Phí ngoàiExcluding</td>
                        </tr>
                    </table>
                    <p class="memo"><b>Nội dung (Details of payment):</b>
                        ${(dataJson.noiDung!'')?html}</p>
                </td>
            </tr>
            <tr>
                <td width="55%">
                    <p class="section">ĐƠN VỊ NHẬN TIỀN(Beneficiary):</p>
                    <table class="details">
                        <tr>
                            <td width="34%">
                                <b>Tên đơn vị nhận tiền:<br/>Beneficiary</b>
                            </td>
                            <td>${(dataJson.tenNguoiHuong!'')?html}</td>
                        </tr>
                        <tr>
                            <td>
                                <b>Số TK/CMND/CCCD:<br/>Acc No./ID Card/PP No</b>
                            </td>
                            <td>${(dataJson.stkNguoiHuong!'')?html}</td>
                        </tr>
                        <tr>
                            <td><b>Ngày cấp:…………………<br/>Date of issue</b></td>
                            <td><b>Nơi cấp:……………………<br/>Place of issue</b></td>
                        </tr>
                        <tr>
                            <td><b>Địa chỉ:<br/>Address</b></td>
                            <td>
                                <#-- TODO(BA-Q5): Địa chỉ người hưởng, giữ trống. -->
                                &#160;
                            </td>
                        </tr>
                        <tr>
                            <td><b>Tại Ngân hàng:<br/>With bank</b></td>
                            <td>${(dataJson.nhNguoiHuong!'')?html}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <table class="signature">
            <tr>
                <td width="55%" colspan="2">
                    <p class="bold">ĐƠN VỊ TRẢ TIỀN(Applicant)</p>
                </td>
                <td width="45%" colspan="2">
                    <p class="bold">NGÂN HÀNG(Bank of Applicant)</p>
                </td>
            </tr>
            <tr>
                <td width="22%">
                    <p class="bold">Kế toán trưởng/Chief Accountant</p>
                    <p class="signature-note">
                        (Ký, ghi họ tên/ Sign, fill full name)
                    </p>
                </td>
                <td width="33%">
                    <p class="bold">Chủ tài khoản/A/C Holder</p>
                    <p class="signature-note">
                        Ký, ghi họ tên, dấu (nếu có)/<br/>
                        Sign, fill full name, seal (if any)
                    </p>
                </td>
                <td width="22.5%">
                    <p class="bold">Ghi sổ ngày (Dated)…../…../…..</p>
                    <p class="bold">Giao dịch viên/Teller</p>
                    <p class="signature-note">Ký, ghi họ tên/Sign, fill full name</p>
                </td>
                <td width="22.5%">
                    <p class="bold">&#160;</p>
                    <p class="bold">Kiểm soát/Supervisor</p>
                    <p class="signature-note">Ký, ghi họ tên/Sign, fill full name</p>
                </td>
            </tr>
        </table>
    </div>
    </#list>
</body>
</pdf>
